{
  "name": "pinia-plugin-subscription",
  "version": "0.1.5",
  "description": "Pinia plugin for Vue.js that helps building Pinia plugins by centralizing subscriber registration and providing a Store base class for store helpers.",
  "type": "module",
  "sideEffects": false,
  "author": "Alexandre Bidaud <alexbidaud85@gmail.com> (https://github.com/AlxBDo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlxBDo/pinia-plugin-subscription.git"
  },
  "homepage": "https://github.com/AlxBDo/pinia-plugin-subscription",
  "bugs": {
    "url": "https://github.com/AlxBDo/pinia-plugin-subscription/issues"
  },
  "keywords": [
    "pinia",
    "vue",
    "plugin",
    "store",
    "subscription",
    "vue3",
    "state-management",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/pinia-plugin-subscription.js",
      "require": "./dist/pinia-plugin-subscription.umd.cjs"
    }
  },
  "main": "./dist/pinia-plugin-subscription.umd.cjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "vite",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "vitest && vite build && tsc --emitDeclarationOnly --outDir dist",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "pinia": "^2.0.0 || ^3.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vue/tsconfig": "^0.8.1",
    "pinia": "^3.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.4"
  }
}
