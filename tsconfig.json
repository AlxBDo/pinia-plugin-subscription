{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.performance.test.ts",
    "src/demo/**",
    "src/demo/main.ts",
    "src/**/*.vue",
    "src/assets/**",
    "src/demo/components/**",
    "src/demo/extending-pinia-store/**",
    "src/demo/models/**",
    "src/demo/stores/**"
  ]
}